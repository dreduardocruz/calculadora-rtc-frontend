# ─────────────────────────────────────────────────────────────────────────────
# Calculadora RTC — Frontend · variáveis de ambiente (Docker Compose)
# Copie para .env e ajuste conforme o seu ambiente:  cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# Endereço da API da Calculadora RTC (backend Spring Boot) que o nginx proxia
# em /api. Em Linux, "host.docker.internal" é resolvido via extra_hosts no
# docker-compose.yml. Exemplos:
#   API_TARGET=http://host.docker.internal:8080   (API na máquina host)
#   API_TARGET=http://api:8080                    (API em outro serviço do compose)
#   API_TARGET=https://minha-api.exemplo.com      (API remota)
API_TARGET=http://host.docker.internal:8080

# Porta publicada no host
FRONTEND_PORT=3000
